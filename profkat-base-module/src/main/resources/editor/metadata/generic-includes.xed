<?xml version="1.0" encoding="UTF-8"?>
<xed:template xmlns:xed="http://www.mycore.de/xeditor">

  <xed:template id="in.out">
    <xed:source uri="{$sourceURI}" />
    <xed:cancel url="{$cancelURL}" />
  </xed:template>

  <xed:template id="cancel.submit">
    <div clas="form-group">
    	<div class="col-md-12">
        <hr></hr>
    	</div>
	  </div>
    <div class="form-group">
      <div class="col-md-offset-3 col-md-6">
        <button type="submit" class="btn btn-light" xed:target="debug">
       		<xed:output i18n="Editor.Common.button.debug" />
        </button>
        <button type="submit" class="btn btn-secondary" xed:target="cancel">
          <xed:output i18n="Editor.Common.button.cancel" />
        </button>                                                                    
        <button type="submit" class="btn btn-primary" xed:target="servlet" xed:href="/servlets/MCRStoreMetadataServlet">
          <xed:output i18n="Editor.Common.button.save" />
        </button>
      </div>
    </div>
  </xed:template>

  <!-- TODO fix ubo i18n -->
  <xed:template id="failed-validation-messages">
    <xed:if test="$xed-validation-failed">
      <div>
        <h3>
          <xed:output i18n="ubo.validation.failed" />
        </h3>
        <ul class="ubo-validation-messages">
          <xed:display-validation-messages />
        </ul>
      </div>
    </xed:if>
  </xed:template>

  <xed:template id="cleanup-rules">
    <xed:cleanup-rule xpath="//*" relevant-if="true()" />
    <xed:cleanup-rule xpath="/mycoreobject/metadata//*" relevant-if="@* or * or (string-length(text()) &gt; 0)" />
    <xed:cleanup-rule xpath="//*[@class='MCRMetaHistoryEvent']/*/text" relevant-if="string-length(text()) &gt; 0" />
    <xed:cleanup-rule xpath="//*[@class='MCRMetaHistoryDate']/*/text" relevant-if="string-length(text()) &gt; 0" />
    <xed:cleanup-rule xpath="//*[@class='MCRMetaXML']/*" relevant-if=".//*[@* or (string-length(text()) &gt; 0)]" />
    <xed:cleanup-rule xpath="//*[@class='MCRMetaLangText']/*" relevant-if="string-length(text()) &gt; 0" />
    <xed:cleanup-rule xpath="//*[@class='MCRMetaLink']/*" relevant-if="string-length(@xlink:href) &gt; 0" />
    <xed:cleanup-rule xpath="/mycoreobject/metadata/*" relevant-if="./*" />
  </xed:template>

  <xed:template id="validation-rules">
    <!--<xed:validate xpath="//*[@class='MCRMetaHistoryEvent']/*" test="string-length(text) &gt; 0 and string-length(von) &gt; 0 and string-length(bis) &gt; 0 and string-length(calendar) &gt; 0" />-->
  </xed:template>
 
</xed:template>
